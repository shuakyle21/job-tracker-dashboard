# Build output. The workflow rsyncs this to the VPS; committing it would create
# merge noise on every run and the repo is not what gets served.
dist/

node_modules/
.DS_Store
*.log

# Never commit a real feed export — sample-feed.csv is the de-identified fixture
# and is the only CSV that belongs in git.
feed-*.csv
*-private.csv

# Deploy key. Generated during setup, added to GitHub as a secret, then deleted
# from the laptop (DEPLOY.md 2.6). Ignored so a slip can't publish it.
deploy_key
deploy_key.pub
known_hosts.txt
