# Build output. The workflow deploys this to Vercel; committing it would create
# merge noise on every run and the repo is not what gets served.
dist/

node_modules/
.DS_Store
*.log

# Never commit a real feed export — sample-feed.json is the de-identified fixture
# and is the only feed export that belongs in git.
feed-*.csv
feed-*.json
*-private.csv
*-private.json

# Local `vercel link` state. CI never creates this — it deploys with
# VERCEL_ORG_ID/VERCEL_PROJECT_ID as env vars instead — but ignore it in case
# anyone links the project locally to use the CLI by hand.
.vercel
