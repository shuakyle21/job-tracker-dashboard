    {
      "parameters": {
        "content": "## Keep the webhook alive\nA webhook created with a personal access token expires 7 days after its last refresh, whatever the token's own expiry is, and Airtable switches notifications off after ~a day of failed pings. Daily: refresh it, re-enable it, or create it. Logic: `n8n/airtable-webhook.js` (tested).",
        "width": 620,
        "height": 120,
        "color": 6
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        380
      ],
      "id": "sync-sticky-13",
      "name": "Note 13"
    }
