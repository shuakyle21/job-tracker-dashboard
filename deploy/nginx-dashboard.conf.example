# Nginx equivalent. Drop into /etc/nginx/conf.d/ (or sites-available + a symlink),
# then: nginx -t && systemctl reload nginx
#
# TLS assumes certbot has already issued a cert for this name:
#   certbot certonly --nginx -d dashboard.example.com

server {
    listen 80;
    listen [::]:80;
    server_name dashboard.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name dashboard.example.com;

    ssl_certificate     /etc/letsencrypt/live/dashboard.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dashboard.example.com/privkey.pem;

    # Point at the symlink. activate.sh swaps its target atomically, so nginx never
    # serves a half-copied release.
    root /srv/dashboard/current;
    index index.html;

    # Nginx caches the resolved path of a symlinked root. Without this it can keep
    # serving the old release after a swap until you reload.
    disable_symlinks off;

    add_header Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'none'; base-uri 'none'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Cache-Control "public, max-age=300, must-revalidate" always;

    gzip on;
    gzip_types text/html text/css application/javascript application/json image/svg+xml;

    location / {
        try_files $uri $uri/ =404;
    }

    access_log /var/log/nginx/dashboard.access.log;
}
