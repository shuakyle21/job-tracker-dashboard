    },
    {
      "dot": "violet",
      "title": "Automation rules",
      "items": [
        "Each email gets Job Application/Processed plus a status label",
        "Feed rows only move forward: earliest date, highest stage",
        "Job Platform is filled in from the sender"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety",
