  "cards": [
    {
      "dot": "emerald",
      "title": "Main path",
      "items": [
        "n8n polls Gmail every 15 min and upserts one Feed row per application",
        "Any Feed change pings n8n Feed Sync, which fires one repository_dispatch",
        "Actions verifies, builds from Feed and deploys to Vercel; cron every 6 h is the backstop"
      ]
    },
    {
      "dot": "violet",
      "title": "Automation rules",
      "items": [
        "Rules classify first; the LLM only sees emails they couldn't parse",
        "Feed rows only move forward: earliest date, highest stage",
        "A daily keep-alive refreshes the Airtable webhook before its 7-day expiry"
      ]
    },
    {
      "dot": "rose",
      "title": "Credentials",
      "items": [
        "GitHub Dispatch (Header Auth) and LLM Router Auth (Bearer) are separate types",
        "Build reads Feed with a read-only token; company names never reach the page",
        "verify.mjs gates every deploy"
      ]
    }
  ]
